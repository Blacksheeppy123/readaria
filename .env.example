# Readaria self-hosted configuration example
# Copy this file to .env and replace placeholders as needed.
# Docker Compose overrides database/Redis hosts and container cache paths.

# ================================
# Required (application startup)
# ================================
# Use unique, strong values in your real .env file.
POSTGRES_PASSWORD=your_postgres_password_here
# Must be at least 32 characters.
SECRET_KEY=change-me-please-0123456789abcdef
JWT_SECRET_KEY=change-me-too-0123456789abcdef
# Required by settings even for non-AI use. Leave the placeholder for RSS-only
# deployments; replace it before using summaries or podcast scripts.
OPENAI_API_KEY=your_openai_api_key_here

# ================================
# LLM (OpenAI-compatible + optional OpenRouter fallback)
# ================================
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=moonshotai/kimi-k2.5

# ================================
# TTS providers
# ================================
# Supported: google, azure (Azure OpenAI), azure_speech, openai.
# Browser Web Speech fallback remains available without a server TTS account.
TTS_PROVIDER=google

# Google Cloud TTS (paid credentials required).
# Set either project-specific path or the standard Google credentials variable.
GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/your/google-cloud-key.json
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_TTS_VOICE=cmn-CN-Standard-A
GOOGLE_CLOUD_TTS_LANGUAGE_CODE=cmn-CN

# Azure Speech: the F0 free tier offers 500,000 neural TTS characters/month.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TTS_VOICE=zh-CN-Xiaoxiao:DragonHDFlashLatestNeural
AZURE_SPEECH_OUTPUT_FORMAT=Audio48Khz96KBitRateMonoMp3

# Azure OpenAI TTS (TTS_PROVIDER=azure).
AZURE_OPENAI_TTS_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_TTS_API_KEY=
AZURE_OPENAI_TTS_DEPLOYMENT=tts
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI TTS (TTS_PROVIDER=openai; paid credentials required).
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_FORMAT=mp3

# Article audio cache and generation controls.
TTS_CACHE_DIR=./audio_cache/
TTS_CACHE_MAX_SIZE_GB=10
TTS_CACHE_EXPIRY_DAYS=14
TTS_PREGENERATE_ENABLED=true
TTS_PREGENERATE_MAX_LENGTH=1000
TTS_SEGMENT_CACHE_DIR=./audio_cache/tts_segments
TTS_PREGENERATE_ASYNC=true
TTS_PREGENERATE_CONCURRENCY=20
TTS_PREGENERATE_MIN_INTERVAL=3
TTS_PREGENERATE_ALL_USERS=false
TTS_MAX_CHARS_PER_REQUEST=3000
TTS_MAX_ARTICLE_LENGTH=30000
TTS_LONG_ARTICLE_STRATEGY=segment
TTS_SEGMENT_GENERATION_TIMEOUT_SECONDS=45
TTS_FIRST_SEGMENTS_PARALLEL_COUNT=1
TTS_SEGMENT_GENERATION_CONCURRENCY=3
TTS_FIRST_PLAYABLE_MIN_SECONDS=25
TTS_SEGMENT_TARGET_FIRST=140
TTS_ENABLE_FALLBACK=true
TTS_DAILY_BUDGET_USD=5.0
TTS_MONTHLY_BUDGET_USD=100.0

# ================================
# Podcast generation
# ================================
PODCAST_ENABLED=true
PODCAST_GENERATION_HOUR=0
PODCAST_GENERATION_MINUTE=15
PODCAST_MAX_ARTICLES=10
PODCAST_STYLE_DEFAULT=deep_dive
PODCAST_AUDIO_CACHE_DIR=./podcast_cache/
PODCAST_DAILY_BUDGET_USD=10.0
PODCAST_MONTHLY_BUDGET_USD=200.0
PODCAST_RAG_CONTEXT_MAX_LENGTH=8000
PODCAST_RAG_CONVERSATION_HISTORY_LIMIT=5

# ================================
# PostgreSQL and Redis
# ================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=readaria
POSTGRES_USER=postgres
POSTGRES_SSLMODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# Optional RSSHub and WeChat routes
# ================================
# Start the bundled optional instance with: docker compose --profile rsshub up -d
RSSHUB_LOCAL_URL=http://localhost:1200
RSSHUB_PROXY_URL=
RSSHUB_ALLOWED_HOSTS=rsshub.app,localhost,127.0.0.1,rsshub,rsshub.moeyy.cn,rsshub.uneasy.win,yangzhi.app
# Legacy routing fields remain accepted for compatibility but are no longer used.
RSSHUB_FORCE_LOCAL=false
RSSHUB_PLATFORM_ROUTING=
WECHAT2RSS_BASE_URL=http://localhost:4001
WECHAT_COOKIE=

# ================================
# Application, authentication, and CORS
# ================================
APP_NAME=Readaria Knowledge Management
APP_VERSION=1.0.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_MIXED=true
GOOGLE_OAUTH_CLIENT_ID=

# ================================
# Rate limits, logging, NLP, and fetching
# ================================
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_TTS=20/minute
RATE_LIMIT_PODCAST=5/minute
RATE_LIMIT_ADMIN=30/minute
RATE_LIMIT_FEED_REFRESH=10/minute
LOG_LEVEL=INFO
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
SPACY_MODEL=zh_core_web_sm
MAX_SUMMARY_LENGTH=150
ENTITY_EXTRACTION_ENABLED=true
FETCH_MAX_RETRIES=3
FETCH_TIMEOUT=30
FETCH_DELAY_SECONDS=2
MAX_ARTICLES_PER_FEED=20
FETCH_MAX_CONCURRENT_PER_HOST=3
FETCH_REQUEST_INTERVAL=0.5
ALLOWED_URL_SCHEMES=http,https
MAX_HTML_CONTENT_LENGTH=500000
USER_FEEDS_CACHE_TTL_SECONDS=120

# ================================
# Optional public demo (disabled by default)
# ================================
# Enables pre-generated content and BYOK AI summaries under /api/demo.
DEMO_MODE=false
DEMO_TURNSTILE_SECRET_KEY=
DEMO_DAILY_INTERACTION_LIMIT=3
# Set both backend and frontend flags for a hosted demo. The frontend build
# also needs VITE_API_BASE_URL when the API is on a different origin.
VITE_DEMO_MODE=false

# ================================
# Optional access lists and error reporting
# ================================
FEATURE_WHITELIST=
FRONTEND_LOG_WHITELIST=
SENTRY_DSN=
API_PORT=8000
